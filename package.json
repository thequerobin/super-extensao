{
  "name": "super-extensao",
  "version": "1.6.10",
  "private": true,
  "description": "Extensão Chromium com limpeza ao sair, controle de autoplay e proteção da última aba.",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:vpn": "node scripts/build-vpn.cjs && npm run build:vpn-ui",
    "build:panels": "node scripts/build-popup-panels.cjs",
    "setup:vpn": "npm ci --prefix vendor/proton-source --ignore-scripts --legacy-peer-deps",
    "setup:sync": "npm ci --prefix vendor/floccus-source --ignore-scripts --legacy-peer-deps",
    "build:sync": "node scripts/build-sync.cjs && npm run build:panels",
    "build:vpn-ui": "node scripts/build-vpn-interface.cjs && npm run build:panels",
    "build:i18n": "node scripts/build-i18n.cjs",
    "build:sync-engine": "node scripts/build-sync-engine.cjs",
    "setup:newtab": "npm ci --prefix vendor/tabliss-source --ignore-scripts",
    "build:newtab": "node scripts/build-newtab.cjs",
    "build:ui": "node scripts/build-ui.cjs",
    "check:ui": "node scripts/build-ui.cjs --check",
    "build:interfaces": "npm run build:ui && npm run build:sync && npm run build:vpn-ui && npm run build:newtab"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2"
  }
}
