{
  "manifest_version": 3,
  "name": "Super Extensão",
  "version": "1.5.19",
  "description": "Nova guia, sincronização de favoritos, Proton VPN, controle de autoplay e limpeza ao sair.",
  "minimum_chrome_version": "116",
  "default_locale": "pt_BR",
  "permissions": [
    "browsingData",
    "storage",
    "alarms",
    "notifications",
    "background",
    "tabs",
    "bookmarks",
    "unlimitedStorage",
    "tabGroups",
    "identity",
    "idle",
    "privacy",
    "proxy",
    "scripting",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_permissions": [
    "history"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Super Extensão",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://account.proton.me/*",
        "https://account.protonvpn.com/*"
      ],
      "js": [
        "vpn-auth-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autoplay-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "navigation-rules.js",
        "autoplay-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://account.proton.me/*",
        "https://account.protonvpn.com/*"
      ],
      "js": [
        "vpn/js/browser-polyfill.min.js",
        "vpn/js/transmit.js"
      ],
      "run_at": "document_start"
    }
  ],
  "options_page": "popup.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/index.html"
  },
  "externally_connectable": {
    "matches": [
      "https://account.proton.me/*",
      "https://account.protonvpn.com/*"
    ]
  },
  "storage": {
    "managed_schema": "vpn/managed-storage-schema.json"
  }
}
